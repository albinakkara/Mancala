---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you requested does not exist.">
  <header class="border-b border-[#ebebeb]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
      <a href="/" class="text-lg font-bold text-[#171717] hover:text-black transition">Online Mancala</a>
      <nav class="flex items-center gap-6 text-sm text-[#666]">
        <a href="/play" class="hover:text-[#171717] transition">Play</a>
        <a href="/rules" class="hover:text-[#171717] transition">Rules</a>
        <a href="/" class="rounded-lg bg-[#171717] px-4 py-2 text-sm font-medium text-white hover:bg-black transition-all shadow-sm">Go Home</a>
      </nav>
    </div>
  </header>
  <div class="flex flex-col items-center justify-center p-8 min-h-[60vh]">
    <h1 class="text-3xl font-bold text-[#171717] mb-4">Page Not Found</h1>
    <p class="text-sm text-[#666] mb-6">The page you&apos;re looking for doesn&apos;t exist or has been moved.</p>
    <a
      href="/"
      class="inline-flex items-center gap-2 rounded-lg bg-[#171717] px-6 py-3 text-sm font-medium text-white hover:bg-black transition-all shadow-sm"
    >
      Go Home
    </a>
  </div>
</Layout>
