---
import Layout from '../layouts/Layout.astro';
import { VariantCard } from '../components/VariantCard';
import { Footer } from '../components/Footer';
import { Navbar } from '../components/Navbar';
import { Play, Shield, Repeat, Check } from 'lucide-react';
---

<Layout
  title="Online Mancala — Play Kalah, Avalanche & Oware Free"
  description="Play Online Mancala at onlinemancala.com. Choose Kalah, Avalanche Mancala, or Oware / Awale with 3 AI difficulties (Easy, Medium, Hard) or 2-player pass & play."
>
  <div class="flex flex-col min-h-screen bg-white">
    <Navbar />

    <!-- HERO SECTION with Vercel Mesh Accent -->
    <section class="relative overflow-hidden border-b border-[#ebebeb] bg-gradient-to-b from-[#fafafa] via-white to-white py-16 sm:py-24">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-48 pointer-events-none opacity-20 blur-3xl">
        <div class="h-full w-full bg-gradient-to-r from-[#007cf0] via-[#7928ca] to-[#ff0080]" />
      </div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] bg-white px-3 py-1 shadow-sm mb-6">
          <span class="h-2 w-2 rounded-full bg-[#0070f3] animate-pulse" />
          <span class="font-mono-code text-xs font-medium text-[#171717]">
            onlinemancala.com — Play Free Online
          </span>
        </div>

        <!-- Heading -->
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-[#171717] max-w-4xl mx-auto leading-tight sm:leading-none">
          The Ancient Game of Strategy, Reimagined for the Modern Web.
        </h1>

        <p class="mt-4 text-base sm:text-lg text-[#4d4d4d] max-w-2xl mx-auto">
          Play <strong>Kalah</strong>, <strong>Avalanche Mancala</strong>, or <strong>Oware / Awale</strong> against intelligent AI algorithms (Easy, Medium, Hard) or challenge a friend in 2-player pass & play mode.
        </p>

        <!-- CTA Button -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/play"
            class="inline-flex items-center gap-2 rounded-lg bg-[#171717] px-6 py-3 text-sm font-medium text-white hover:bg-black transition-all shadow-sm active:scale-98"
          >
            <Play className="h-4 w-4" />
            Play Now
          </a>
          <a
            href="/rules"
            class="inline-flex items-center gap-2 rounded-lg border border-[#ebebeb] bg-white px-6 py-3 text-sm font-medium text-[#171717] hover:bg-[#f5f5f5] transition"
          >
            Learn the Rules
          </a>
        </div>

        <!-- Features Highlights -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-6 text-xs text-[#666] font-mono-code">
          <div class="flex items-center gap-1.5">
             <Check className="h-4 w-4 text-[#0070f3]" />
             3 Mancala Game Variants
          </div>
          <div class="flex items-center gap-1.5">
             <Check className="h-4 w-4 text-[#7928ca]" />
             3 CPU AI Difficulties
          </div>
          <div class="flex items-center gap-1.5">
             <Check className="h-4 w-4 text-[#eb367f]" />
             Pass & Play 2-Player
          </div>
          <div class="flex items-center gap-1.5">
             <Check className="h-4 w-4 text-[#00dfd8]" />
             No Registration Required
          </div>
        </div>

        <!-- MORE ABOUT LINKS SECTION -->
        <div class="mt-12 mb-8 max-w-3xl mx-auto">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <a href="/about-us" class="group flex items-center justify-between rounded-xl border border-[#ebebeb] bg-white p-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl">
              <div class="flex items-center gap-3 text-left">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#7928ca]/10">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7928ca" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-[#171717] group-hover:text-black transition">About Us</h3>
                  <p class="text-xs text-[#888888]">Discover our mission and values.</p>
                </div>
              </div>
              <svg class="h-4 w-4 text-[#888888] group-hover:text-black transition" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </a>

            <a href="/contact-us" class="group flex items-center justify-between rounded-xl border border-[#ebebeb] bg-white p-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl">
              <div class="flex items-center gap-3 text-left">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#0070f3]/10">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0070f3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-[#171717] group-hover:text-black transition">Contact Us</h3>
                  <p class="text-xs text-[#888888]">Send feedback or get support.</p>
                </div>
              </div>
              <svg class="h-4 w-4 text-[#888888] group-hover:text-black transition" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </a>

            <a href="/privacy-policy" class="group flex items-center justify-between rounded-xl border border-[#ebebeb] bg-white p-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl">
              <div class="flex items-center gap-3 text-left">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#eb367f]/10">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eb367f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-[#171717] group-hover:text-black transition">Privacy Policy</h3>
                  <p class="text-xs text-[#888888]">How we protect your data.</p>
                </div>
              </div>
              <svg class="h-4 w-4 text-[#888888] group-hover:text-black transition" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </a>

            <a href="/terms-and-conditions" class="group flex items-center justify-between rounded-xl border border-[#ebebeb] bg-white p-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl">
              <div class="flex items-center gap-3 text-left">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#00dfd8]/10">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00dfd8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-[#171717] group-hover:text-black transition">Terms &amp; Conditions</h3>
                  <p class="text-xs text-[#888888]">Read our usage terms.</p>
                </div>
              </div>
              <svg class="h-4 w-4 text-[#888888] group-hover:text-black transition" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- CHOOSE MANCALA VARIANT SECTION -->
    <section class="py-12 bg-white border-b border-[#ebebeb]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#171717]">
            Choose Your Mancala Variant
          </h2>
          <p class="mt-1 text-sm text-[#888888]">
            Select one of the 3 classic variants to start your match.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <VariantCard
            id="kalah"
            title="Kalah"
            subtitle="Standard International Rules"
            description="The most popular Mancala variant. Fill side stores, score extra turns when landing in your store, and capture opposite pits!"
            badge="Classic Kalaha"
            keyRule="Extra turns on store landing + opposite pit captures."
            isActive={false}
            onSelect={() => {}}
          />

          <VariantCard
            id="avalanche"
            title="Avalanche Mancala"
            subtitle="Continuous Multi-Lap Sowing"
            description="Fast-paced continuous sowing. If your last seed lands in a non-empty pit, pick up ALL seeds and keep sowing!"
            badge="Multi-Lap Sowing"
            keyRule="Continuous laps until landing in an empty pit or store."
            isActive={false}
            onSelect={() => {}}
          />

          <VariantCard
            id="oware"
            title="Oware / Awale"
            subtitle="Traditional West African Game"
            description="Strategic 12-pit board without side stores. Harvest opponent pits containing 2 or 3 seeds with Feed and Grand Slam rules!"
            badge="West African Awale"
            keyRule="Harvest 2/3 seeds, enforced Feed & Grand Slam protection."
            isActive={false}
            onSelect={() => {}}
          />
        </div>
      </div>
    </section>

    <!-- QUICK LINKS SECTION -->
    <section class="py-12 bg-[#fafafa] border-b border-[#ebebeb]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a
            href="/play"
            class="group flex flex-col items-center text-center rounded-xl border border-[#ebebeb] bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-[#0070f3]/10 mb-4">
               <Play className="h-6 w-6 text-[#0070f3]" />
            </div>
            <h3 class="text-lg font-semibold text-[#171717] mb-2 group-hover:text-black transition">Play Mancala</h3>
            <p class="text-sm text-[#888888]">Jump straight into the game. Choose your variant and start playing against AI or a friend.</p>
          </a>

          <a
            href="/rules"
            class="group flex flex-col items-center text-center rounded-xl border border-[#ebebeb] bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-[#7928ca]/10 mb-4">
               <Shield className="h-6 w-6 text-[#7928ca]" />
            </div>
            <h3 class="text-lg font-semibold text-[#171717] mb-2 group-hover:text-black transition">Rules & Strategy</h3>
            <p class="text-sm text-[#888888]">Learn the rules for all three variants and master advanced strategies to improve your game.</p>
          </a>

          <a
            href="/stats"
            class="group flex flex-col items-center text-center rounded-xl border border-[#ebebeb] bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-[#eb367f]/10 mb-4">
               <Repeat className="h-6 w-6 text-[#eb367f]" />
            </div>
            <h3 class="text-lg font-semibold text-[#171717] mb-2 group-hover:text-black transition">Statistics</h3>
            <p class="text-sm text-[#888888]">Track your win rates, total games, and performance across all Mancala variants.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- SEO CONTENT SECTION -->
    <section class="py-16 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-tight text-[#171717] text-center mb-4">
      Play the Best Online Mancala Game
    </h2>
    <p class="text-center text-[#888888] mb-10 max-w-2xl mx-auto">
      Free, no-download mancala with Kalah, Avalanche, and Oware. Play against AI or challenge a friend in 2-player pass &amp; play.
    </p>
    <div class="prose prose-lg max-w-3xl mx-auto text-[#4d4d4d] space-y-6">
      <p>
        Welcome to the ultimate destination to <strong>play online mancala</strong> in your browser. Whether you are looking for a free, no-download experience or a challenging match against the computer, our platform offers the <strong>best online mancala game</strong> available today.
      </p>
      <p>
        Mancala is one of the oldest known board games in the world, with origins tracing back thousands of years to ancient Africa and Asia. Today, this timeless <strong>mancala board game</strong> is enjoyed by millions, and our digital adaptation brings the classic <strong>mancala board</strong> to life with smooth animations, intuitive controls, and multiple gameplay modes—all available completely free.
      </p>
      <h3 class="text-xl font-semibold text-[#171717] mt-8 mb-3">Multiple Variants, One Great Experience</h3>
      <p>
        Our <strong>free online mancala</strong> app supports three beloved variants: <strong>Kalah mancala</strong>, <strong>Oware mancala</strong>, and <strong>Avalanche mancala</strong>. Each variant has its own unique rules and strategic depth, making it easy to find a style that suits your taste. If you are new to the game, you can review detailed <strong>mancala instructions</strong> and <strong>mancala rules</strong> directly in the app. The in-game rules panel explains every variant step by step, from basic sowing to advanced capture mechanics, so first-time players can start enjoying mancala within seconds.
      </p>
      <p>
        For seasoned players, mastering <strong>mancala strategy</strong> is essential. Learn when to sacrifice seeds, when to force extra turns, and how to limit your opponent&apos;s options through careful pit selection. Understanding the nuances between kalah, oware, and avalanche will make you a more versatile player across every format.
      </p>
      <h3 class="text-xl font-semibold text-[#171717] mt-8 mb-3">2-Player &amp; Social Play</h3>
      <p>
        Playing <strong>online mancala 2 player</strong> is simple and instinctive. The <strong>pass &amp; play</strong> mode lets two people share one device in the same room, alternating turns while the mancala board stays clearly visible on the screen. Whether you are parked on the couch or hanging out at a café, the board stays responsive on desktop, tablet, and mobile, so you can enjoy a match together wherever you are.
      </p>
      <p>
        If you prefer to practice solo before challenging a friend, our CPU opponents come in three difficulty levels—Easy, Medium, and Hard—so you can sharpen your <strong>mancala strategy</strong> before jumping into competitive matches. Once you are ready, invite a friend over and use the same 2-player pass &amp; play mode to <strong>play online mancala with friends</strong> in person.
      </p>
      <h3 class="text-xl font-semibold text-[#171717] mt-8 mb-3">Why This Is the Best Online Mancala Game</h3>
      <p>
        Choosing the right variant matters. <strong>Kalah mancala</strong> is perfect for families and casual gamers because the side stores and capture rules create exciting comebacks. <strong>Oware mancala</strong> appeals to players who love deep, positional thinking on a 12-pit board without side stores. Meanwhile, <strong>Avalanche mancala</strong> delivers non-stop action with its continuous multi-lap sowing rule—land in a non-empty pit, pick up everything, and keep sowing. No matter which variant you pick, the core experience remains the same: a beautifully rendered <strong>mancala board game</strong> that runs smoothly on desktop, tablet, and mobile browsers.
      </p>
      <p>
        If you have been searching for where to <strong>play online mancala</strong>, look no further. Our platform is optimized for speed, accessibility, and enjoyment. The responsive board scales perfectly to any screen size, and the clean interface keeps distractions away so you can focus on <strong>mancala rules</strong> and strategy. Bookmark this page and start playing today—experience why so many players consider this the <strong>best online mancala game</strong> on the web.
      </p>
    </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-16 bg-[#fafafa] border-t border-[#ebebeb]" id="faq">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-[#171717] text-center mb-10">
          Frequently Asked Questions
        </h2>
        <div class="space-y-0 divide-y divide-[#ebebeb] bg-white rounded-xl border border-[#ebebeb]">
          <div class="faq-item">
            <button class="faq-toggle w-full flex items-center justify-between py-5 px-6 text-left cursor-pointer" aria-expanded="false">
              <span class="text-sm font-semibold text-[#171717] pr-4">How to capture in Mancala?</span>
              <span class="faq-icon flex-shrink-0 text-[#888888] transition-transform duration-200">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2v14M2 9h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
            </button>
            <div class="faq-answer overflow-hidden max-h-0 transition-all duration-200">
              <p class="px-6 pb-5 text-sm text-[#4d4d4d] leading-relaxed">In Mancala, a capture happens when your final seed lands in an empty pit on your side and the directly opposite opponent pit contains seeds. You collect all the seeds from the opponent&apos;s pit plus your own landing seed into your store. This is a core mechanic in Kalah and some other variants.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-toggle w-full flex items-center justify-between py-5 px-6 text-left cursor-pointer" aria-expanded="false">
              <span class="text-sm font-semibold text-[#171717] pr-4">How to set up Mancala?</span>
              <span class="faq-icon flex-shrink-0 text-[#888888] transition-transform duration-200">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2v14M2 9h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
            </button>
            <div class="faq-answer overflow-hidden max-h-0 transition-all duration-200">
              <p class="px-6 pb-5 text-sm text-[#4d4d4d] leading-relaxed">To set up Mancala, place 4 seeds in each of the 12 playing pits (6 per player) and leave the two larger stores empty at each end. This gives a total of 48 seeds on the board. The board is ready when all playing pits are evenly filled.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-toggle w-full flex items-center justify-between py-5 px-6 text-left cursor-pointer" aria-expanded="false">
              <span class="text-sm font-semibold text-[#171717] pr-4">How to play Mancala?</span>
              <span class="faq-icon flex-shrink-0 text-[#888888] transition-transform duration-200">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2v14M2 9h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
            </button>
            <div class="faq-answer overflow-hidden max-h-0 transition-all duration-200">
              <p class="px-6 pb-5 text-sm text-[#4d4d4d] leading-relaxed">Mancala is played by picking up all seeds from one of your pits and sowing them one-by-one counter-clockwise, skipping your opponent&apos;s store. The goal is to collect the most seeds in your store. For detailed rules and step-by-step gameplay, see our full <a href="/rules" class="text-[#0070f3] underline font-medium">Mancala Rules</a> page.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-toggle w-full flex items-center justify-between py-5 px-6 text-left cursor-pointer" aria-expanded="false">
              <span class="text-sm font-semibold text-[#171717] pr-4">How many marbles in Mancala?</span>
              <span class="faq-icon flex-shrink-0 text-[#888888] transition-transform duration-200">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2v14M2 9h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
            </button>
            <div class="faq-answer overflow-hidden max-h-0 transition-all duration-200">
              <p class="px-6 pb-5 text-sm text-[#4d4d4d] leading-relaxed">A standard Mancala game uses 48 marbles (seeds), with 4 placed in each of the 12 playing pits. Some variants may use a different number of seeds per pit, so always confirm the setup before starting.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-toggle w-full flex items-center justify-between py-5 px-6 text-left cursor-pointer" aria-expanded="false">
              <span class="text-sm font-semibold text-[#171717] pr-4">Where did Mancala originate?</span>
              <span class="faq-icon flex-shrink-0 text-[#888888] transition-transform duration-200">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2v14M2 9h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
            </button>
            <div class="faq-answer overflow-hidden max-h-0 transition-all duration-200">
              <p class="px-6 pb-5 text-sm text-[#4d4d4d] leading-relaxed">Mancala is one of the oldest known board games, originating in Africa thousands of years ago. Evidence of Mancala-like games has been found in ancient Egyptian tombs and across sub-Saharan Africa. The name &quot;Mancala&quot; comes from the Arabic word <em>naqala</em>, meaning &quot;to move.&quot; It spread across the world through trade and migration, evolving into hundreds of regional variants.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ JSON-LD -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How to capture in Mancala?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "In Mancala, a capture happens when your final seed lands in an empty pit on your side and the directly opposite opponent pit contains seeds. You collect all the seeds from the opponent's pit plus your own landing seed into your store. This is a core mechanic in Kalah and some other variants."
            }
          },
          {
            "@type": "Question",
            "name": "How to set up Mancala?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "To set up Mancala, place 4 seeds in each of the 12 playing pits (6 per player) and leave the two larger stores empty at each end. This gives a total of 48 seeds on the board. The board is ready when all playing pits are evenly filled."
            }
          },
          {
            "@type": "Question",
            "name": "How to play Mancala?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Mancala is played by picking up all seeds from one of your pits and sowing them one-by-one counter-clockwise, skipping your opponent's store. The goal is to collect the most seeds in your store. For detailed rules and step-by-step gameplay, see our full Mancala Rules page at /rules."
            }
          },
          {
            "@type": "Question",
            "name": "How many marbles in Mancala?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A standard Mancala game uses 48 marbles (seeds), with 4 placed in each of the 12 playing pits. Some variants may use a different number of seeds per pit, so always confirm the setup before starting."
            }
          },
          {
            "@type": "Question",
            "name": "Where did Mancala originate?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Mancala is one of the oldest known board games, originating in Africa thousands of years ago. Evidence of Mancala-like games has been found in ancient Egyptian tombs and across sub-Saharan Africa. The name Mancala comes from the Arabic word naqala, meaning 'to move.' It spread across the world through trade and migration, evolving into hundreds of regional variants."
            }
          }
        ]
      }
    </script>

    <!-- FAQ Accordion JS -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.faq-toggle').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var item = btn.closest('.faq-item');
            var answer = item.querySelector('.faq-answer');
            var icon = btn.querySelector('.faq-icon');
            var isOpen = btn.getAttribute('aria-expanded') === 'true';

            if (isOpen) {
              answer.style.maxHeight = '0px';
              icon.style.transform = 'rotate(0deg)';
              btn.setAttribute('aria-expanded', 'false');
            } else {
              answer.style.maxHeight = answer.scrollHeight + 'px';
              icon.style.transform = 'rotate(45deg)';
              btn.setAttribute('aria-expanded', 'true');
            }
          });
        });
      });
    </script>

    <Footer />
  </div>
</Layout>
