---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Something went wrong" description="An unexpected error occurred.">
  <div class="flex flex-col items-center justify-center p-8 min-h-[60vh]">
    <h1 class="text-3xl font-bold text-[#171717] mb-4">Something went wrong</h1>
    <p class="text-sm text-[#666] mb-6">Please refresh the page or go back home.</p>
    <a
      href="/"
      class="inline-flex items-center gap-2 rounded-lg bg-[#171717] px-6 py-3 text-sm font-medium text-white hover:bg-black transition-all shadow-sm"
    >
      Go Home
    </a>
  </div>
</Layout>
